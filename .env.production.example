# Production settings: provide these as real environment variables (secrets
# manager / platform config). Do not deploy a .env file with real secrets.
# The app refuses to start if a required value is missing or insecure.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=            # 50+ random characters
DJANGO_ALLOWED_HOSTS=api.example.com
# JWT_SIGNING_KEY=            # optional; defaults to DJANGO_SECRET_KEY

POSTGRES_DB=taskpilot
POSTGRES_USER=taskpilot
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# Exact frontend origin(s); no wildcards
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com

# Refresh cookie. SameSite=Lax works when app and API share a site
# (app.example.com + api.example.com). Use None only for unrelated sites.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=Lax
# REFRESH_COOKIE_DOMAIN=

# Email (password resets, invitations)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=TaskPilot <no-reply@example.com>

# Files
DJANGO_STATIC_ROOT=/srv/taskpilot/static
DJANGO_MEDIA_ROOT=/srv/taskpilot/media

# Interactive API docs (/api/docs/) are off in production unless enabled
API_DOCS_ENABLED=false

# Number of reverse proxies in front of Django (for per-client throttling)
DRF_NUM_PROXIES=1
# DJANGO_HSTS_PRELOAD=false
