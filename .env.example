# Development settings. Copy to .env (gitignored) or run scripts/setup-local-db.ps1,
# which creates the database role and writes .env with generated secrets.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=taskpilot
POSTGRES_USER=taskpilot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Browser origins allowed to call the API (the Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional
# SEED_PASSWORD=password-for-demo-users
# JWT_ACCESS_MINUTES=10
# JWT_REFRESH_DAYS=14
# API_DOCS_ENABLED=true
